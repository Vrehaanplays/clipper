<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Clipper</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Legitimate background audio recording. This is the capability that keeps the
	     recorder alive with the app backgrounded and the screen off. It is an Info.plist
	     key, not an entitlement. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- Shown in the system microphone permission prompt. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Clipper listens through the built-in microphone so it can transcribe nearby speech and build your searchable memory. Everything is processed and stored on this iPhone.</string>

	<!-- Required even for fully on-device recognition. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Clipper transcribes speech it hears entirely on this iPhone, so your conversations become searchable. No audio or text ever leaves the device.</string>

	<!-- Opts the app in to Live Activities / Dynamic Island. Whether one is started is a
	     Clipper setting; whether it is displayed is up to iOS and the user. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>microphone</string>
	</array>

	<!-- An empty launch screen dict gives the standard system background. -->
	<key>UILaunchScreen</key>
	<dict/>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- Deep links from Spotlight results, widgets and the Live Activity. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.vrehaanplays.clipper.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>clipper</string>
			</array>
		</dict>
	</array>

	<!-- Recordings are private to the app sandbox. No Files browsing, no document
	     provider, no iTunes file sharing. Export is user-driven via the share sheet. -->
	<key>UIFileSharingEnabled</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>

	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
